      "parameters": {
        "jsCode": "const rawOutput = $input.first().json.text;\nlet category = \"General\";\nlet action = \"send\";\nlet response = rawOutput;\ntry {\n  const cleaned = rawOutput.replace(/```json|```/g, \"\").trim();\n  const parsed = JSON.parse(cleaned);\n  category = (parsed.category || \"General\").trim();\n  action = (parsed.action || \"send\").trim().toLowerCase();\n  response = (parsed.response || rawOutput).replace(/\\n/g, \"<br>\");\n} catch (error) {\n  response = rawOutput.replace(/\\n/g, \"<br>\");\n}\nreturn [{ json: { category, action, response } }];"
      },
